// Prisma schema — defined but no migrations ever run
// Database is SQLite in development, but connection string not configured
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
}

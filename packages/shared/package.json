{
  "name": "@turpan/shared",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared types, fs utilities, git helpers, and process utils for Turpan",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "turpan",
    "shared",
    "utilities"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npx vitest run",
    "lint": "npx tsc --noEmit",
    "clean": "rm -rf dist"
  }
}

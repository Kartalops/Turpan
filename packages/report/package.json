{
  "name": "@turpan/report",
  "version": "0.1.0",
  "description": "Turpan Analysis report generation — markdown, HTML, JSON, scorecard, evidence index",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "turpan",
    "report",
    "code-review",
    "markdown",
    "html"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@turpan/core": "workspace:*",
    "@turpan/shared": "workspace:*",
    "@turpan/fix-engine": "workspace:*",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@turpan/fix-engine": "workspace:*",
    "@types/node": "^20.11.0",
    "vitest": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
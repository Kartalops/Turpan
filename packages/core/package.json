{
  "name": "@turpan/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core Turpan engine — orchestrator, fingerprinting, analyzers, plugins, and command runner",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "turpan",
    "core",
    "orchestrator",
    "analyzer",
    "code-review"
  ],
  "dependencies": {
    "@turpan/dependency-audit": "workspace:*",
    "@turpan/diff-analyzers": "workspace:*",
    "@turpan/git-diff": "workspace:*",
    "@turpan/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "npx vitest run",
    "lint": "npx tsc --noEmit",
    "clean": "rm -rf dist"
  }
}

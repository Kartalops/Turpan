{
  "name": "turpan",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive review and fix agent CLI",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "eval:build": "pnpm build && pnpm eval",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}